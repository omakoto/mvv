{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./docs",
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "noUnusedLocals": true,
        "sourceMap": true,
        "lib": [
            "es2022",
            "dom"
        ],
        "types": [
            "jquery",
            "jqueryui",
            "webmidi",
            "audioworklet",
            "dom-screen-wake-lock"
        ],
        "skipLibCheck": true
    },
    "include": [
        "src/**/*"
    ]
}
